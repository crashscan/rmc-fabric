#!/bin/sh
set -eu

CONF=/etc/inventory-agent/inventory-agentd.conf
[ -f "$CONF" ] && . "$CONF"

DAEMON=${DAEMON:-/usr/sbin/inventory-agentd}
RUNDIR=${RUNDIR:-/run/inventory-agent}
PIDFILE=${PIDFILE:-$RUNDIR/inventory-agentd.pid}
LOGFILE=${LOGFILE:-/var/log/inventory-agentd.log}
TRANSPORT=${TRANSPORT:-dbus}
TRANSPORT_CONFIG=${TRANSPORT_CONFIG:-system}
STARTUP_WAIT_SEC=${STARTUP_WAIT_SEC:-20}
DBUS_REPLY_TIMEOUT_MS=${DBUS_REPLY_TIMEOUT_MS:-3000}

if [ "$TRANSPORT_CONFIG" = "session" ]; then
    DBUS_SEND_BUS=--session
    DBUS_SOCKET=${DBUS_SESSION_BUS_ADDRESS:-}
else
    DBUS_SEND_BUS=--system
    DBUS_SOCKET=/run/dbus/system_bus_socket
fi

responds() {
    dbus-send "$DBUS_SEND_BUS" --print-reply --reply-timeout="$DBUS_REPLY_TIMEOUT_MS" \
        --dest=org.rsc.Inventory /org/rsc/Inventory org.rsc.Inventory.GetReady 2>/dev/null \
        | grep -q "boolean"
}

i=0
while [ "$i" -lt "$STARTUP_WAIT_SEC" ]; do
    [ "$TRANSPORT_CONFIG" = "session" ] && [ -n "$DBUS_SOCKET" ] && break
    [ "$TRANSPORT_CONFIG" != "session" ] && [ -S "$DBUS_SOCKET" ] && break
    sleep 1; i=$((i+1))
done
[ "$TRANSPORT_CONFIG" = "session" ] || [ -S "$DBUS_SOCKET" ] || { echo "system D-Bus unavailable" >&2; exit 1; }

mkdir -p "$RUNDIR"

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "inventory-agentd already running (pid $(cat "$PIDFILE"))" >&2
    exit 1
fi

"$DAEMON" --transport="$TRANSPORT" --transport_config="$TRANSPORT_CONFIG" >>"$LOGFILE" 2>&1 &
PID=$!
echo "$PID" > "$PIDFILE"

i=0
while [ "$i" -lt "$STARTUP_WAIT_SEC" ]; do
    if ! kill -0 "$PID" 2>/dev/null; then
        echo "inventory-agentd exited during startup" >&2
        rm -f "$PIDFILE"
        exit 1
    fi
    responds && exit 0
    sleep 1; i=$((i+1))
done

echo "inventory-agentd did not become responsive in ${STARTUP_WAIT_SEC}s" >&2
kill "$PID" 2>/dev/null || true
rm -f "$PIDFILE"
exit 1
