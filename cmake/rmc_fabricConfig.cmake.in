@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Try to locate DBusCxx and SigCxx if consumers use public client targets
# These are PRIVATE in most targets so failure is non-fatal for contract-only consumers.
find_dependency(DBusCxx QUIET)
find_dependency(SigCxx  QUIET)

include("${CMAKE_CURRENT_LIST_DIR}/rmc_fabricTargets.cmake")

check_required_components(rmc_fabric)
