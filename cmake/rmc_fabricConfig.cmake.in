@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(
    PREPEND
    CMAKE_MODULE_PATH
    "${CMAKE_CURRENT_LIST_DIR}"
)

find_dependency(
    rsc_util 2.1
    CONFIG
    REQUIRED
    COMPONENTS
        client_contract
        service_runtime
        service_dbus
        filewatch
)

find_dependency(
    SigCxx
    REQUIRED
    MODULE
)

include(
    "${CMAKE_CURRENT_LIST_DIR}/rmc_fabricTargets.cmake"
)

check_required_components(rmc_fabric)