@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# DBusCxx and SigCxx are PUBLIC link dependencies of the client targets;
# consumers that link those targets must have them available.
find_dependency(DBusCxx REQUIRED)
find_dependency(SigCxx  REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/rmc_fabricTargets.cmake")

check_required_components(rmc_fabric)
