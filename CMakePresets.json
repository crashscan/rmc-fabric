{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer Debug",
      "description": "Debug build with tests and all warnings",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "RMC_FABRIC_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimised release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "RMC_FABRIC_WERROR": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan/UBSan",
      "description": "Debug build with address and undefined behaviour sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "RMC_FABRIC_SANITIZE": "address,undefined",
        "RMC_FABRIC_WERROR": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Debug build with gcov/lcov coverage instrumentation (requires lcov)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "RMC_FABRIC_COVERAGE": "ON"
      }
    },
    {
      "name": "integration",
      "displayName": "Integration",
      "description": "Debug build with hermetic D-Bus integration tests enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "RMC_FABRIC_BUILD_INTEGRATION_TESTS": "ON",
        "RMC_FABRIC_WERROR": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz",
      "description": "Clang/libFuzzer build for bounded codec ingress smoke tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "RMC_FABRIC_BUILD_FUZZ_TARGETS": "ON"
      }
    },
    {
      "name": "release-package",
      "displayName": "Release Package Validation",
      "description": "Release build with package/install verification enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "RMC_FABRIC_WERROR": "OFF"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark",
      "description": "Release build with benchmark executables enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "RMC_FABRIC_BUILD_BENCHMARKS": "ON",
        "RMC_FABRIC_WERROR": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",      "configurePreset": "dev" },
    { "name": "release",  "configurePreset": "release" },
    { "name": "asan",     "configurePreset": "asan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "integration", "configurePreset": "integration" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "release-package", "configurePreset": "release-package" },
    { "name": "benchmark", "configurePreset": "benchmark" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release-package",
      "configurePreset": "release-package",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
